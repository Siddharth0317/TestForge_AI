# ==============================================================================
# TestForge AI — Environment Configuration Template (.env.example)
# Copy this file to .env before starting services: cp .env.example .env
# DO NOT COMMIT REAL CREDENTIALS OR SECRETS TO SOURCE CONTROL
# ==============================================================================

# ------------------------------------------------------------------------------
# Core Backend API (Node.js + Express + TypeScript)
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=4000
FRONTEND_ORIGIN=http://localhost:5173
LOG_LEVEL=info

# JWT Secrets for Authentication (Generate a strong random string in production)
JWT_SECRET=change-this-to-a-secure-random-secret-at-least-32-chars-long
JWT_EXPIRES_IN=7d

# MongoDB Persistence
MONGODB_URI=mongodb://localhost:27017/testforge_ai

# Internal Service Communication Key (Shared between Backend and AI Service)
INTERNAL_SERVICE_KEY=replace-with-internal-service-secret-token

# AI Service Endpoint (Internal)
AI_SERVICE_URL=http://localhost:8000

# ------------------------------------------------------------------------------
# AI Service (Python + FastAPI)
# ------------------------------------------------------------------------------
AI_SERVICE_PORT=8000
AI_SERVICE_HOST=0.0.0.0
AI_LOG_LEVEL=INFO

# LLM Provider Configuration ('gemini', 'openai', or 'mock')
LLM_PROVIDER=mock
LLM_MODEL=gemini-1.5-pro

# API Keys (Leave blank when using LLM_PROVIDER=mock)
GEMINI_API_KEY=
OPENAI_API_KEY=

# ML Model Artifact Path
CLASSIFIER_MODEL_PATH=models/requirement_classifier.joblib

# ------------------------------------------------------------------------------
# Frontend Application (React + Vite)
# ------------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:4000/api/v1
VITE_APP_TITLE=TestForge AI

# ------------------------------------------------------------------------------
# Automation Worker (Selenium + Python)
# ------------------------------------------------------------------------------
SELENIUM_HEADLESS=true
SELENIUM_BROWSER=chrome
SELENIUM_DEFAULT_TIMEOUT=15
CI_FIXTURE_URL=http://localhost:8080

